    {
      "name": "Ideas (Founder)",
      "item": [
        {
          "name": "Create Idea (Draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('ideaId', jsonData.idea._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"AI-Powered Climate Prediction System\",\n  \"abstract\": \"A revolutionary machine learning system that predicts climate patterns with 95% accuracy using advanced neural networks and satellite data.\",\n  \"problem\": \"Current climate prediction models lack accuracy and cannot process real-time data efficiently, leading to poor disaster preparedness and agricultural planning.\",\n  \"solution\": \"Our AI system uses deep learning algorithms combined with satellite imagery, IoT sensors, and historical data to provide accurate, real-time climate predictions up to 30 days in advance.\",\n  \"team\": \"Dr. Jane Smith (ML Expert, 10 years), John Doe (Data Scientist, 8 years), Alice Johnson (Climate Researcher, 12 years)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ideas",
              "host": ["{{baseUrl}}"],
              "path": ["ideas"]
            }
          }
        },
        {
          "name": "Update Idea",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated: AI-Powered Climate Prediction System\",\n  \"abstract\": \"Updated abstract with more details about our revolutionary approach.\",\n  \"problem\": \"Updated problem statement with more context.\",\n  \"solution\": \"Updated solution with technical details.\",\n  \"team\": \"Updated team information.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ideas/{{ideaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ideas", "{{ideaId}}"]
            }
          }
        },
        {
          "name": "Get My Ideas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ideas/my",
              "host": ["{{baseUrl}}"],
              "path": ["ideas", "my"]
            }
          }
        },
        {
          "name": "Get Idea by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ideas/{{ideaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ideas", "{{ideaId}}"]
            }
          }
        },
        {
          "name": "Submit Idea for Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ideas/{{ideaId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["ideas", "{{ideaId}}", "submit"]
            }
          }
        },
        {
          "name": "Upload Pitch Deck",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "pitchDeck",
                  "type": "file",
                  "src": "/path/to/your/pitch.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/ideas/{{ideaId}}/upload",
              "host": ["{{baseUrl}}"],
              "path": ["ideas", "{{ideaId}}", "upload"]
            }
          }
        },
        {
          "name": "Delete Idea (Draft Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ideas/{{ideaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ideas", "{{ideaId}}"]
            }
          }
        }
      ]
