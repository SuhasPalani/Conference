    {
      "name": "Role Requests",
      "item": [
        {
          "name": "Submit Role Request (Founder)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('requestId', jsonData.roleRequest._id);",
                  "    console.log('Role request submitted. Admin will review.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"founder\",\n  \"reason\": \"I am a serial entrepreneur with 5 years of experience in AI/ML startups. I have successfully launched 2 products in the computer vision space and want to submit my latest innovation for evaluation. I believe my idea can revolutionize climate prediction.\",\n  \"previousWork\": \"Co-founder of VisionAI (acquired 2022), Technical Lead at DeepTech Solutions, Published 3 papers on neural networks. Portfolio: visionai.com, deeptech.io\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/role-requests",
              "host": ["{{baseUrl}}"],
              "path": ["role-requests"]
            }
          }
        },
        {
          "name": "Submit Role Request (Evaluator)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"evaluator\",\n  \"reason\": \"I am a senior AI researcher with 10+ years of experience in machine learning and have served as a reviewer for top-tier conferences (NeurIPS, ICML, CVPR). I want to contribute to the community by evaluating innovative AI ideas and helping founders improve their proposals.\",\n  \"previousWork\": \"Senior Research Scientist at Google AI, PhD in Machine Learning from MIT, 50+ peer-reviewed publications, Program Committee member for NeurIPS 2023. Google Scholar: scholar.google.com/citations?user=xyz\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/role-requests",
              "host": ["{{baseUrl}}"],
              "path": ["role-requests"]
