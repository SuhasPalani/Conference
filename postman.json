            ],
            "url": {
              "raw": "{{baseUrl}}/evaluations/assigned?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["evaluations", "assigned"],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Submit Evaluation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('evaluationId', jsonData.evaluation._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ideaId\": \"{{ideaId}}\",\n  \"scores\": {\n    \"innovation\": 9,\n    \"feasibility\": 8,\n    \"impact\": 10,\n    \"presentation\": 7\n  },\n  \"comments\": \"Excellent idea with strong potential. The climate prediction approach is innovative and the team has relevant expertise. Some concerns about implementation timeline but overall very promising.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/evaluations",
              "host": ["{{baseUrl}}"],
              "path": ["evaluations"]
            }
          }
        },
        {
          "name": "Get Evaluation by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluations/{{evaluationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["evaluations", "{{evaluationId}}"]
            }
          }
        },
        {
          "name": "Update Evaluation (Before Submit)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scores\": {\n    \"innovation\": 10,\n    \"feasibility\": 9,\n    \"impact\": 10,\n    \"presentation\": 8\n  },\n  \"comments\": \"Updated: Outstanding idea with excellent execution potential.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/evaluations/{{evaluationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["evaluations", "{{evaluationId}}"]
            }
          }
        },
        {
          "name": "Get Evaluations for Idea",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluations/idea/{{ideaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["evaluations", "idea", "{{ideaId}}"]
            }
          }
        }
      ]
    },
